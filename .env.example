# Anwendung
APP_NAME="Dispo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Produktion: APP_DEBUG=false, APP_URL mit https://, SESSION_SECURE_COOKIE=true
# SESSION_SECURE_COOKIE=true

# GEN-003: UI-Sprache Deutsch; interne Speicherung UTC (config/app.php timezone)
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_DISPLAY_TIMEZONE=Europe/Berlin

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Produktion und Speedit: MySQL (ADR-002, ADR-003). Lokal darf SQLite für den Schnellstart genutzt werden.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dispo
DB_USERNAME=root
DB_PASSWORD=

# V1: Datenbanktreiber, kein Redis als Voraussetzung (ADR-002)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Privater Dateispeicher; später s3 ohne Fachlogikänderung
DISPO_FILES_DISK=local
QUEUE_CONNECTION=database
# retry_after (90) muss größer sein als queue:work --timeout (45).
DB_QUEUE_RETRY_AFTER=90
QUEUE_WORKER_TIMEOUT=45
QUEUE_WORKER_MAX_TIME=50
CACHE_STORE=database
# CACHE_PREFIX=

# Redis ist in V1 nicht erforderlich. Werte nur falls später aktiviert.
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Lokal: log. Speedit/Produktion: smtp (ADR-003). Keine echten Zugangsdaten committen.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-Adapter vorbereitet, in V1 nicht Pflicht. Leer lassen.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
